{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "coreStyles": false,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "64rem",
      "wideSize": "80rem"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "primary",
          "name": "B.C. blue",
          "color": "#013366"
        },
        {
          "slug": "gold",
          "name": "B.C. gold",
          "color": "#fcba19"
        },
        {
          "slug": "white",
          "name": "White",
          "color": "#ffffff"
        },
        {
          "slug": "body-text",
          "name": "Body text",
          "color": "#2d2d2d"
        },
        {
          "slug": "link",
          "name": "Link blue",
          "color": "#255a90"
        },
        {
          "slug": "muted",
          "name": "Light grey",
          "color": "#faf9f8"
        },
        {
          "slug": "pale-blue",
          "name": "Light blue",
          "color": "#f1f8fe"
        },
        {
          "slug": "border",
          "name": "Border grey",
          "color": "#d8d8d8"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "bc-sans",
          "name": "BC Sans",
          "fontFamily": "\"BC Sans\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "BC Sans",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/BCSans-Regular.woff2"
              ]
            },
            {
              "fontFamily": "BC Sans",
              "fontStyle": "normal",
              "fontWeight": "700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/BCSans-Bold.woff2"
              ]
            },
            {
              "fontFamily": "BC Sans",
              "fontStyle": "italic",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/BCSans-Italic.woff2"
              ]
            },
            {
              "fontFamily": "BC Sans",
              "fontStyle": "italic",
              "fontWeight": "700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/BCSans-BoldItalic.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem"
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1rem"
        },
        {
          "slug": "large",
          "name": "Large body",
          "size": "1.125rem"
        },
        {
          "slug": "heading-three",
          "name": "Heading 3",
          "size": "1.75rem"
        },
        {
          "slug": "heading-two",
          "name": "Heading 2",
          "size": "2rem"
        },
        {
          "slug": "heading-one",
          "name": "Heading 1",
          "size": "2.25rem"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw",
        "vh"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "20",
          "name": "Small",
          "size": "0.5rem"
        },
        {
          "slug": "30",
          "name": "Medium",
          "size": "1rem"
        },
        {
          "slug": "40",
          "name": "Large",
          "size": "1.5rem"
        },
        {
          "slug": "50",
          "name": "Extra large",
          "size": "2rem"
        },
        {
          "slug": "60",
          "name": "Double extra large",
          "size": "2.5rem"
        },
        {
          "slug": "70",
          "name": "Triple extra large",
          "size": "3rem"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|white",
      "text": "var:preset|color|body-text"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "clamp(1rem, 3vw, 2rem)",
        "right": "clamp(1rem, 3vw, 2rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|bc-sans",
      "fontSize": "var:preset|font-size|large",
      "fontWeight": "400",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "color": {
          "text": "var:preset|color|primary"
        },
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.25"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|heading-one"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|heading-two"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|heading-three"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|link"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|primary"
          }
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|primary",
          "text": "var:preset|color|white"
        },
        "border": {
          "radius": "4px"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "right": "1.5rem",
            "bottom": "0.75rem",
            "left": "1.5rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|bc-sans",
          "fontWeight": "700",
          "fontSize": "1rem",
          "lineHeight": "1.5"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontSize": "1.5rem",
          "fontWeight": "700",
          "lineHeight": "1.3"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "1rem",
          "fontWeight": "400"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/post-title": {
        "spacing": {
          "margin": {
            "bottom": "1.5rem"
          }
        }
      },
      "core/post-excerpt": {
        "spacing": {
          "margin": {
            "top": "0.75rem"
          }
        }
      },
      "core/separator": {
        "color": {
          "text": "var:preset|color|border"
        }
      },
      "core/quote": {
        "border": {
          "left": {
            "color": "var:preset|color|gold",
            "width": "4px",
            "style": "solid"
          }
        },
        "spacing": {
          "padding": {
            "left": "1.5rem"
          }
        }
      },
      "core/paragraph": {
        "typography": {
          "fontSize": "var:preset|font-size|large"
        }
      },
      "core/list": {
        "typography": {
          "fontSize": "var:preset|font-size|large"
        }
      },
      "core/details": {
        "typography": {
          "fontSize": "var:preset|font-size|large"
        }
      },
      "core/table": {
        "typography": {
          "fontSize": "var:preset|font-size|large"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "bc-topic-landing",
      "title": "Topic landing page",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "bc-detail-content",
      "title": "Detailed content page",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "bc-long-reference",
      "title": "Long reference page",
      "postTypes": [
        "page"
      ]
    }
  ]
}
